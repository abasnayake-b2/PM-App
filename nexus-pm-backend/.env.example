# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dfn_pm
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY=true

# Redis (rate limiting + JWT blacklist)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT signing keys (required in production — generate RSA key pair)
JWT_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem

# App
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Security (production)
# SPRING_PROFILES_ACTIVE=prod
# SWAGGER_ENABLED=false
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=Strict
# RATE_LIMIT_ENABLED=true
# MAX_UPLOAD_BYTES=10485760

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025
