# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dfn_pm
DB_USERNAME=root
DB_PASSWORD=your_password_here
DB_USE_SSL=false
DB_ALLOW_PUBLIC_KEY=true

# Redis (rate limiting + JWT blacklist)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT signing keys (required in production — generate RSA key pair)
JWT_PRIVATE_KEY_PATH=classpath:keys/private.pem
JWT_PUBLIC_KEY_PATH=classpath:keys/public.pem

# App
APP_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Security (production)
# SPRING_PROFILES_ACTIVE=prod
# SWAGGER_ENABLED=false
# COOKIE_SECURE=true
# COOKIE_SAME_SITE=Strict
# RATE_LIMIT_ENABLED=true
# MAX_UPLOAD_BYTES=10485760

# Mail
MAIL_HOST=localhost
MAIL_PORT=1025

# Cache (reference / lookup data — lowers repeated DB reads)
# CACHE_ENABLED=true
# CACHE_TTL_MINUTES=360
# CACHE_WARMUP_ON_STARTUP=true
# CACHE_DAILY_REFRESH_CRON=0 0 2 * * *
# LOG_FILE=logs/dfn-pm-api.log
# LOG_LEVEL_ROOT=INFO
# LOG_LEVEL_APP=INFO
# LOG_LEVEL_HTTP=INFO
# LOG_LEVEL_AUDIT=INFO
# LOG_LEVEL_WEB=INFO
# LOG_LEVEL_SECURITY=WARN
# LOG_LEVEL_HIBERNATE_SQL=DEBUG
# LOG_LEVEL_HIBERNATE_BIND=TRACE
# LOG_LEVEL_HIBERNATE_TYPE=TRACE

# Jira Cloud (Project Backlog Sync — email + API token)
# JIRA_ENABLED=true
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=your_jira_api_token
# JIRA_CR_ISSUE_TYPES=Change,Change Request,CR,New Feature,Feature,Features
