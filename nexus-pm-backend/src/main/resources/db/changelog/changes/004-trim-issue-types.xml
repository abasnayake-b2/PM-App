<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="trim-issue-types" author="dfnpm">
    <update tableName="issue_type">
      <column name="name" value="Stories"/>
      <where>workflow_code = 'STORY'</where>
    </update>
    <update tableName="issue_type">
      <column name="name" value="Bugs"/>
      <where>workflow_code = 'BUG'</where>
    </update>
    <sql>UPDATE rd_issue SET issue_type_id = '66666666-6666-6666-6666-666666666604'
         WHERE issue_type_id = '66666666-6666-6666-6666-666666666606'</sql>
    <sql>DELETE FROM workflow_rule
         WHERE issue_type_id = '66666666-6666-6666-6666-666666666606'</sql>
    <delete tableName="issue_type">
      <where>workflow_code = 'SUBTASK'</where>
    </delete>
  </changeSet>

</databaseChangeLog>
