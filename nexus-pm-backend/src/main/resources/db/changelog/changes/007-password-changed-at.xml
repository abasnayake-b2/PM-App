<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

  <changeSet id="password-changed-at" author="dfnpm">
    <addColumn tableName="user_auth">
      <column name="password_changed_at" type="TIMESTAMP"/>
    </addColumn>
    <sql>UPDATE user_auth SET password_changed_at = COALESCE(updated_at, created_at, CURRENT_TIMESTAMP)
         WHERE password_changed_at IS NULL</sql>
  </changeSet>

</databaseChangeLog>
