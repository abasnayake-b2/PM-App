<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="026-rd-issue-bms-id" author="dfn-pm">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="rd_issue"/>
            <not>
                <columnExists tableName="rd_issue" columnName="bms_id"/>
            </not>
        </preConditions>
        <comment>BMS ID on RD, shown next to JIRA ID.</comment>
        <addColumn tableName="rd_issue">
            <column name="bms_id" type="VARCHAR(80)" afterColumn="jira_id"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
