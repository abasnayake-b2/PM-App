<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="016-team-management-profile-picture" author="dfn-pm">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="team_management" columnName="profile_picture"/>
            </not>
        </preConditions>
        <addColumn tableName="team_management">
            <column name="profile_picture" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
