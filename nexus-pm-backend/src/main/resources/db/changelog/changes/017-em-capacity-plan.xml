<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="017-em-capacity-plan" author="dfn-pm">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="em_capacity_plan"/>
            </not>
        </preConditions>
        <createTable tableName="em_capacity_plan">
            <column name="id" type="CHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="em_management_id" type="CHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="additional_resources" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="CHAR(36)"/>
            <column name="updated_by" type="CHAR(36)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="em_capacity_plan"
                baseColumnNames="em_management_id"
                referencedTableName="team_management"
                referencedColumnNames="id"
                constraintName="fk_em_capacity_plan_em"/>
    </changeSet>

    <changeSet id="017-cr-type-field" author="dfn-pm">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">
                SELECT COUNT(*) FROM issue_field_definition WHERE field_key = 'cr_type'
            </sqlCheck>
        </preConditions>
        <insert tableName="issue_field_definition">
            <column name="id" value="c1000001-0000-0000-0000-000000000008"/>
            <column name="field_key" value="cr_type"/>
            <column name="label" value="CR Type"/>
            <column name="data_type" value="DROPDOWN"/>
            <column name="required" valueBoolean="false"/>
            <column name="active" valueBoolean="true"/>
            <column name="system_field" valueBoolean="true"/>
            <column name="section_code" value="GENERAL"/>
            <column name="display_order" valueNumeric="25"/>
            <column name="options_json" value="[&quot;CR&quot;,&quot;AMC&quot;]"/>
        </insert>
    </changeSet>
</databaseChangeLog>
