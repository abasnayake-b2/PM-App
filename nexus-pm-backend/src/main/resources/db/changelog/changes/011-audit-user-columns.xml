        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Bootstrap runner also ensures these columns when Liquibase is disabled. -->
    <changeSet id="011-audit-user-columns-region" author="dfn-pm">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="region"/>
                <not><columnExists tableName="region" columnName="created_by"/></not>
            </and>
        </preConditions>
        <addColumn tableName="region">
            <column name="created_by" type="CHAR(36)"/>
            <column name="updated_by" type="CHAR(36)"/>
        </addColumn>
    </changeSet>

