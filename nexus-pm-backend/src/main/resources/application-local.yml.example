# Copy to application-local.yml and edit as needed.
# Activate with: mvn spring-boot:run "-Dspring-boot.run.profiles=dev,local"
#
# Schema is applied with sql/build.sql + sql/seed.sql — keep Liquibase disabled.

spring:
  liquibase:
    enabled: false
  datasource:
    url: jdbc:mysql://localhost:3306/dfn_pm?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
    username: root
    password: change_me
  data:
    redis:
      host: localhost
      port: 6379

dfnpm:
  cors:
    allowed-origins: http://localhost:5173
  security:
    swagger-enabled: true
    cookie-secure: false
    # Set true when Redis/Memurai is running
    redis-enabled: false
    rate-limit-enabled: false
  # Assistant (OpenAI-compatible). Default off — no LLM cost until enabled.
  # Local Ollama example: ollama serve && ollama pull llama3.1
  # Schema/data: apply sql/build.sql + sql/seed.sql (AI tables/permissions included)
  ai:
    enabled: false
    default-profile: local-ollama
    api-key: ollama
    base-url: http://localhost:11434/v1
    model: llama3.1
    max-tokens: 2048
    max-tool-rounds: 4
    profiles:
      local-ollama:
        label: Local Ollama (free)
        base-url: http://localhost:11434/v1
        model: llama3.1
        api-key: ollama
      openai-prod:
        label: OpenAI GPT-4o mini
        base-url: https://api.openai.com/v1
        model: gpt-4o-mini
        api-key: ${OPENAI_API_KEY:}

management:
  health:
    mail:
      enabled: false
    redis:
      enabled: false

# Optional: verbose app logging for local troubleshooting
# Uncomment Hibernate lines only when debugging SQL:
logging:
  level:
    com.nexuspm: DEBUG
    org.springframework.web: DEBUG
    # org.hibernate.SQL: DEBUG
    # org.hibernate.orm.jdbc.bind: TRACE
